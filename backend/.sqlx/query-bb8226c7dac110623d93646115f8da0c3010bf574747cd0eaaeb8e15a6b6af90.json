  "query": "SELECT id, created_at, reporter_contact, body, context_url, resolved_at, resolved_by\n             FROM abuse_reports\n             WHERE resolved_at IS NULL\n               AND ($1::timestamptz IS NULL OR (created_at, id) > ($1, $2))\n             ORDER BY created_at ASC, id ASC\n             LIMIT $3",
