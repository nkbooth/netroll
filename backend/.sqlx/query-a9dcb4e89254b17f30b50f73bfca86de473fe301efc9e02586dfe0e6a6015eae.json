  "query": "SELECT id, session_id, destination, target, attempts, request_sent_at,\n                       claimed_until\n                 FROM net_delivery_jobs\n                WHERE state = 'pending'\n                  AND claimed_until IS NOT NULL\n                  AND claimed_until <= $1\n                ORDER BY claimed_until, session_id\n                LIMIT $2",
