  "query": "SELECT id, occurred_at, actor_account_id, action, target_type, target_id, metadata,\n                    context_session_id, context_definition_id\n             FROM audit_log\n             WHERE occurred_at >= $4\n               AND ($1::timestamptz IS NULL OR (occurred_at, id) < ($1, $2))\n             ORDER BY occurred_at DESC, id DESC\n             LIMIT $3",
