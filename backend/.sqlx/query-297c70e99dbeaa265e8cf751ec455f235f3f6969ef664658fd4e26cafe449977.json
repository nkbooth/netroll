  "query": "SELECT\n                    d.id,\n                    d.title,\n                    d.description,\n                    d.country,\n                    d.state,\n                    d.grid,\n                    d.net_category,\n                    d.net_type,\n                    d.expected_duration_minutes,\n                    d.link_token,\n                    d.archived_at,\n                    f.created_at AS favorited_at\n               FROM net_favorites f\n               JOIN net_definitions d ON d.id = f.net_definition_id\n               WHERE f.account_id = $1\n               ORDER BY f.created_at DESC, f.net_definition_id DESC",
