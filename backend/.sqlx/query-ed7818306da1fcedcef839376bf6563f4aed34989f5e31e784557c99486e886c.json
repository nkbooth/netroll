  "query": "UPDATE accounts\n             SET email_verified_at = COALESCE(email_verified_at, $2), updated_at = $2,\n                 deleted_at = NULL\n             WHERE email = $1\n             RETURNING id, email, email_verified_at, callsign, display_name, location, grid,\n                       avatar_url, deleted_at, disabled_at",
