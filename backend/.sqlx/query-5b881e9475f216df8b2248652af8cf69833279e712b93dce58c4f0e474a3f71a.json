  "query": "SELECT r.account_id, a.callsign, r.role, r.granted_by, r.created_at\n             FROM net_session_roles r\n             JOIN accounts a ON a.id = r.account_id\n             WHERE r.net_session_id = $1\n             ORDER BY r.created_at, r.account_id",
