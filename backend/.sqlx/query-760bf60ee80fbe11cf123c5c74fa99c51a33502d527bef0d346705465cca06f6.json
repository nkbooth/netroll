  "query": "SELECT id, email, callsign, display_name, disabled_at, deleted_at\n               FROM accounts\n              WHERE lower(callsign) LIKE $1 ESCAPE '\\'\n                 OR lower(display_name) LIKE $1 ESCAPE '\\'\n              ORDER BY callsign NULLS LAST, display_name NULLS LAST, id\n              LIMIT $2",
