  <mj-head>
    <mj-preview></mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
      <mj-text color="$NR_TEXT$" font-size="15px" line-height="24px" />
      <mj-section background-color="$NR_SURFACE$" padding="24px" />
      <mj-button background-color="$NR_ACCENT_DEEP$" color="$NR_ON_ACCENT$" font-size="16px" font-weight="600" border-radius="6px" />
      <mj-divider border-color="$NR_BORDER$" border-width="1px" />
    </mj-attributes>
  </mj-head>
