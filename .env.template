# Development .env template for NetRoll — plain values only, so a fresh clone
# runs with nothing but this file: `set -a; . ./.env.template; set +a; cargo run`
# inside the devcontainer, or `op run --env-file .env.template -- <command>` if
# you keep your own secrets in 1Password.
#
# Everything here is a value a contributor could read off compose.yaml anyway.
# The two secrets (KEK, BOT_MITIGATION_SECRET) are left blank, which the app
# treats as unset: QRZ features stay off and bot mitigation stays disabled until
# you mint a value. A real .env is never committed (.gitignore blocks it).
#
# Values with spaces are double-quoted so the file sources under bash as well as
# under a dotenv parser. NOTE: op inject/op run resolve secret references even
# in comments, so a disabled reference must not use the real syntax.

# ---- Database ----
# Matches the credentials compose.yaml hands the postgres service.
DATABASE_URL=postgres://netroll:netroll-dev@localhost:5432/netroll

# ---- SMTP (magic-link email delivery) ----
# The compose mailpit catcher: no TLS, no auth, browsable at localhost:8025.
# An empty username selects the unauthenticated dev transport, so leave it
# empty rather than inventing one — a set username makes the app attempt an
# AUTH exchange mailpit will reject.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# REQUIRED, non-secret: the From address every outgoing email carries, either
# bare (no-reply@example.com) or as `Display Name <user@domain>`. The app
# refuses to boot while it is unset — there is no fallback sender, because a
# placeholder one mails real users from a domain that cannot receive replies.
# Dev sends to mailpit, so a .invalid domain is correct here; production sets
# its own real sending domain.
MAIL_FROM="NetRoll by N1CCK <no-reply@netroll.invalid>"

# ---- Public URL ----
# Base URL emailed magic links point at. Plain value, not a secret. REQUIRED:
# unset or empty is a hard boot error — there is no dev-server fallback, because
# one would boot fine in production and email links to nobody's server. Must be
# an https:// origin; plain http:// is accepted only for loopback hosts
# (localhost, 127.0.0.1, [::1]), which is the only reason this dev value passes.
PUBLIC_BASE_URL=http://localhost:5173

# ---- Envelope encryption ----
# Instance key-encryption key — injected at runtime, never stored in Postgres
# or backups. Base64-encoded 32 bytes for AES-256 (mint one with
# `openssl rand -base64 32`). OPTIONAL: with no KEK the app still boots and runs
# every non-QRZ feature; QRZ credential endpoints then return 503 until it is
# set. A present-but-malformed KEK (bad base64 / wrong length) is a hard boot
# error.
KEK=

# ---- Resource caps ----
# Per-account resource limits. Plain integers (NOT secrets). Unset ⇒ the
# documented defaults below; a set-but-invalid value (0, negative, non-numeric)
# is a hard boot error, never a silent fallback.
# Max active (non-archived) nets one account may own (default 7). CAUTION:
# the net-creation rate limiter's burst is a fixed 12
# (see rate_limit.rs::NET_CREATION_BURST) — if you raise this cap to 12 or
# above, a user filling their whole quota in one sitting may be throttled
# before ever reaching it. The app logs a boot-time warning if this happens;
# raising the burst itself requires a source change (it is not env-configurable).
MAX_NETS_PER_USER=7
# Max owners per net (default 5).
MAX_OWNERS_PER_NET=5

# ---- Aggregate magic-link cap ----
# Instance-wide ceiling on outbound magic-link email, in sends per hour. A plain
# integer (NOT a secret). Unset ⇒ 60/hour; a set-but-invalid value (0, negative,
# non-numeric) is a hard boot error, never a silent fallback — a 0 would mute all
# magic-link mail, and magic links are the ONLY way anyone signs in.
#
# This is a SEPARATE mechanism from the per-address quota (a fixed 3 requests per
# address per 15 minutes), not a replacement for it. That quota is independent
# per address, so cycling a harvested address list drives unbounded third-party
# mail through your SMTP relay; this bounds the TOTAL across all addresses. Both
# are in force, per-address first.
#
# SCOPE: EVERY magic-link request draws on this budget, whoever it is for.
# Requests over it are dropped silently with the same 202 a successful request
# gets — deliberately, so a capped response cannot be used to probe which
# addresses have accounts. Once this budget is spent, addresses that completed a
# sign-in here in the last 30 days can still fall back to the separate reserve
# below, so an abuse campaign against unknown addresses cannot lock your own
# users out. That proven-address set is in-memory, so a restart clears it. The
# reserve is a BUDGET, not a guarantee: an attacker who first proves control of a
# handful of addresses can drain it too — see the reserve's own notes below.
#
# Default sizing: 60/hour sits orders of magnitude above a small instance's real
# signup + sign-in volume while bounding an email-bombing campaign to something
# your relay's sending reputation survives. Raise it if you run a large instance.
MAGIC_LINK_AGGREGATE_SENDS_PER_HOUR=60

# Reserve budget, in sends per hour, drawn on ONLY when the cap above is spent
# and ONLY for addresses that completed a sign-in here in the last 30 days. Same
# fail-loud posture: unset ⇒ 120/hour; a set-but-invalid value is a boot error.
#
# TOTAL outbound magic-link mail is bounded by the two together — that total
# bound is the point. Sized above the general cap because this budget serves the
# population that must never be locked out of the only sign-in path the app has.
#
# WHAT IT DOES NOT PROMISE: because it is a bounded budget rather than an
# unlimited exemption, it can be drained. Roughly ten addresses that have each
# signed in here once, requesting 3 links per 15 min apiece (within the
# per-address quota), consume 120/hour — the whole default reserve — after which
# a genuine returning user is dropped too. Raising this number raises both the
# effort to drain it AND the total outbound ceiling, by the same amount; there
# is no setting that buys one without the other.
#
# SIZING THE BOUND — READ THIS BEFORE YOU SIZE YOUR RELAY. Each number above is
# a token bucket that starts FULL and then refills at that rate, so a pool of N
# admits N immediately plus up to another N over the following hour: up to 2N in
# the first hour after the process starts, settling to N/hour after that. On the
# defaults the ceiling is therefore up to 120 general + 240 reserve = UP TO 360
# SENDS IN A FRESH-BOOT HOUR, against a sustained 180/hour. A crash-looping
# process resets both buckets on every boot, so if you are sizing what your SMTP
# relay's reputation must survive, use the burst figure (360), not the sustained
# one (180). Both scale linearly: halve the numbers and you halve both figures.
MAGIC_LINK_RESERVE_SENDS_PER_HOUR=120

# ---- Retention ----
# How many days dead magic-link tokens, sessions and email-change tokens are kept
# before a background sweep deletes them. Plain integer (NOT a secret). Unset ⇒
# 30 days; a set-but-invalid value (0, negative, non-numeric) is a hard boot
# error, never a silent fallback — a 0 collapses the cutoff onto "now", leaving
# no retained history at all to correlate a sign-in against the audit log.
#
# WHY IT EXISTS: nothing in the app had ever deleted a row from those three
# tables. The account-deletion cascade only fires when an account is FINALIZED,
# so it covers neither leak: magic_link_tokens is keyed on email with no account
# FK, so a finalized account's rows survive it; and for an account that is never
# deleted — every real account — the cascade never fires at all, while a row
# accrues per sign-in request, per sign-in, and per email-change request. This
# sweep is time-based and account-independent, so one pass reaches both.
#
# ONE window covers all three tables; they hold the same class of short-lived
# credential artifact. What gets deleted: tokens whose expiry is older than the
# window, and sessions whose absolute 30-day cap OR whose revocation is older
# than the window. Idle time (last_seen_at) is deliberately NOT part of it —
# idle expiry is judged per request against a separate window, so pruning on it
# would tie row lifetime to a policy this sweep does not own. Nothing this sweep
# deletes can sign a signed-in user out.
#
# BEST-EFFORT, and worth knowing before you tune it: the sweep runs once at
# startup and then hourly. It does not batch its deletes, nothing waits for it at
# shutdown, and a tick that fails is not retried until the next hour. None of the
# three columns it filters on is indexed either, deliberately — an index would
# cost write amplification on the sign-in path — so every tick is three
# sequential scans, hourly, for as long as the process runs. At any realistic
# instance size that is noise, and it is what keeps the tables bounded.
#
# In STEADY STATE a lost sweep costs a delay and nothing else: no one observes a
# row between the moment it dies and the moment it goes. The FIRST sweep is the
# exception, and those limits compose there. On tables that have never been
# pruned it is the largest single DELETE this system will ever issue, it starts
# at boot, and because it is one unbatched statement that nothing waits for, a
# restart in the middle of it rolls the whole thing back — not part of it. So an
# interrupted first sweep costs a full rollback plus the dead tuples it churned,
# and that repeats on every boot until one sweep runs to completion. It will
# complete (no statement timeout is configured), but on a large backlog give the
# first boot after upgrading time to finish rather than restarting into it.
TOKEN_RETENTION_DAYS=30

# ---- Bot mitigation ----
# HMAC signing secret for the honeypot + timing form tokens on signup and net
# creation. Its PRESENCE is the on/off switch: unset/empty ⇒ mitigation DISABLED
# (signup + net creation behave exactly as before, the default posture); set ⇒
# ENABLED. Must be at least 16 bytes — a present-but-short secret is a hard
# boot error (a short key is brute-forceable from the
# public GET /api/form-tokens endpoint's token/signature pairs, silently
# defeating mitigation while it looks configured). Mint one with
# `openssl rand -base64 32`. Self-hosted — no external CAPTCHA vendor.
BOT_MITIGATION_SECRET=

# ---- Uploaded avatars ----
# Directory uploaded avatar images are written to and served from (as
# `/avatars/<account-id>.<ext>`). Plain path, NOT a secret. Unset ⇒ `data/avatars`
# relative to the working directory. The directory is created at boot and probed
# for writability; an unusable path is a hard boot error rather than a failure on
# a user's first upload. MOUNT A VOLUME HERE in production — otherwise every
# avatar is lost when the container is replaced. Uploads are capped at 1 MB and
# accepted only when the file's own magic bytes say PNG/JPEG/WebP/GIF (the
# filename and Content-Type are never trusted).
AVATAR_DIR=data/avatars

# ---- Analytics (optional, off by default) ----
# The site domain this instance reports as — it must match a site registered in
# the Plausible instance below, or events are rejected. Unset/empty ⇒ NO
# analytics: the tracker chunk is never even downloaded and nothing is requested
# from any external host, which is the default for every self-hoster. Set it and
# the SPA starts Plausible's cookie-less tracker (no PII).
PLAUSIBLE_DOMAIN=
# Origin of a SELF-HOSTED Plausible, e.g. https://analytics.example. Events are
# posted to <origin>/api/event; the tracker itself ships in our own bundle, so
# no script is fetched from this host. Unset with a domain set ⇒ Plausible's own
# cloud host. Ignored entirely when PLAUSIBLE_DOMAIN is unset (a host with
# nothing to report as would receive nothing).
PLAUSIBLE_SCRIPT_HOST=

# ---- Content Security Policy ----
# The app emits its own Content-Security-Policy on every response whose
# Content-Type is HTML — never on JSON, assets or avatars. Unset ⇒ the DERIVED
# default: scripts and fonts from the app's origin only; images from the origin
# plus data: (docs icons) and any https: host (avatars, Gravatar included); no
# plugins, no framing, no <base>; and a connect-src naming the app's origin, the
# WebSocket origin derived from PUBLIC_BASE_URL, and the analytics origin when
# PLAUSIBLE_DOMAIN is set. Styles are NOT origin-only: <style> elements and
# stylesheets are (style-src-elem 'self'), but inline style="" attributes are
# allowed (style-src-attr 'unsafe-inline') because React sets them throughout —
# an attribute cannot carry a selector, so it cannot do the exfiltration an
# injected <style> element can. The plain style-src 'self' 'unsafe-inline' is
# the fallback for browsers predating the elem/attr split. Both variables are
# plain values, NOT secrets, and both are left unset here on purpose.
#
# CSP_POLICY replaces the WHOLE policy verbatim (trimmed) — no merging, you own
# it. OPT OUT BY LEAVING IT UNSET: `CSP_POLICY=` (set, blank) is a hard boot
# error, unlike the set-but-blank convention PLAUSIBLE_SCRIPT_HOST= uses above.
# Also refused at boot: a value carrying CR/LF or any byte outside visible
# ASCII, and a value that names no recognised CSP directive. Illustrative
# override — the derived default for this dev origin with analytics off:
# CSP_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; style-src-elem 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' ws://localhost:5173; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'
# CSP_REPORT_ONLY=true sends the same policy as Content-Security-Policy-Report-
# Only: the browser logs violations and enforces nothing — INCLUDING
# frame-ancestors 'none', the app's only anti-framing rule (it sets no
# X-Frame-Options), so the page is frameable for as long as this is on. For
# watching a console during a rollout, nothing more. Exactly `true` or `false`
# (trimmed, case-insensitive); anything else is a hard boot error — a typo must
# never silently enforce or silently disarm.
# CSP_REPORT_ONLY=false

# ---- Donations (optional, off by default) ----
# Ko-fi username behind the footer's "Support NetRoll" link. Unset/empty ⇒ no
# link renders. A plain link only — no third-party widget, no overlay script,
# nothing that can track a visitor.
KOFI_USERNAME=

# ---- Platform admins ----
# Comma-separated list of admin account emails, matched case-insensitively
# against the account's normalized stored email. OPTIONAL: unset/empty ⇒ NO
# admins configured (the app still boots and runs; the bounded admin surface —
# view/resolve abuse reports, disable/re-enable accounts — is simply unreachable,
# the safe default, mirroring the optional-KEK posture). A present list with a
# blank or non-address entry (e.g. a trailing comma) is a hard boot error, never
# a silent partial parse. Platform admin is a SEPARATE axis from per-net roles.
# Example: ADMIN_ACCOUNT_EMAILS=admin@example.com,ops@example.com
#
# Set so the admin dashboard is reachable locally without ad-hoc exports: sign
# in as this address and the local mail catcher delivers the link. It grants
# nothing until an account registers under it on THIS instance, so it is not a
# credential and confers nothing off this machine.
ADMIN_ACCOUNT_EMAILS=admin@example.com
